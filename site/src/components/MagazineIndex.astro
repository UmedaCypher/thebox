---
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import { SITE, T, articlePath, getArticles, magazinePath, type Lang } from '../lib/i18n';
import { ORG_ID, blogId, blogName } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const articles = await getArticles(lang);
const path = magazinePath(lang);

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': blogId(lang),
  name: blogName(lang),
  description: t.magazineDescription,
  url: SITE + path,
  inLanguage: lang,
  publisher: { '@id': ORG_ID },
  blogPost: articles.map((a) => ({
    '@type': 'BlogPosting',
    '@id': `${SITE + articlePath(a)}#article`,
    headline: a.data.title,
    url: SITE + articlePath(a),
    datePublished: a.data.publishedAt.toISOString(),
    articleSection: a.data.category,
  })),
}];
---
<Base
  lang={lang}
  title={t.magazineTitle}
  description={t.magazineDescription}
  path={path}
  alternates={[{ lang: 'fr', path: magazinePath('fr') }, { lang: 'en', path: magazinePath('en') }]}
  jsonLd={jsonLd}
>
  <section class="wrap mag-hero">
    <h1>{t.magazine}</h1>
    <p>{t.intro}</p>
  </section>
  {articles.length === 0
    ? <p class="wrap empty">{t.empty}</p>
    : (
      <section class="wrap cards">
        {articles.map((a, i) => <ArticleCard article={a} featured={i === 0} />)}
      </section>
    )}
  <section class="wrap mag-about">
    <p>{t.about}</p>
  </section>
</Base>
