---
import Base from '../layouts/Base.astro';
import ArticleCard from './ArticleCard.astro';
import { SITE, T, getArticles, magazinePath, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const articles = await getArticles(lang);
const path = magazinePath(lang);

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Arcora — ${t.magazine}`,
  description: t.magazineDescription,
  url: SITE + path,
  inLanguage: lang,
  publisher: { '@type': 'Organization', name: 'Arcora', url: SITE, logo: SITE + '/icons/icon-512x512.png' },
}];
---
<Base
  lang={lang}
  title={t.magazineTitle}
  description={t.magazineDescription}
  path={path}
  alternates={[{ lang: 'fr', path: magazinePath('fr') }, { lang: 'en', path: magazinePath('en') }]}
  jsonLd={jsonLd}
>
  <section class="wrap mag-hero">
    <h1>{t.magazine}</h1>
    <p>{t.intro}</p>
  </section>
  {articles.length === 0
    ? <p class="wrap empty">{t.empty}</p>
    : (
      <section class="wrap cards">
        {articles.map((a, i) => <ArticleCard article={a} featured={i === 0} />)}
      </section>
    )}
</Base>
