# En-têtes HTTP des fichiers statiques (Cloudflare Workers, static assets).
# La redirection http → https se règle dans Cloudflare : SSL/TLS → Edge Certificates → Always Use HTTPS.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(self)
  Strict-Transport-Security: max-age=31536000

# Fichiers dont le nom contient une empreinte (app Vite et magazine Astro) : jamais modifiés, cache d'un an
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Service workers et manifeste : toujours revalidés, sinon une mise à jour de l'app tarde à arriver
/sw.js
  Cache-Control: no-cache
/push-sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
